{
    "root": true,
    "env": {
        "node": true,
        "es2021": true,
        "jest": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
        "ecmaVersion": 2021,
        "sourceType": "script"
    },
    "rules": {
        "no-unused-vars": ["warn", { "args": "none" }]
    },
    "ignorePatterns": ["BK/", "node_modules/", "coverage/"]
}
