# Copy this file to .env and fill in real values. .env itself is gitignored.

PORT=3001

# Local MySQL connection (utils/database.js falls back to these if DBDATABASE/
# DBUSERNAME/DBPASSWORD are unset — that's the normal path for local dev).
DB_LOCAL_DATABASE=fitwebapp
DB_LOCAL_USERNAME=root
DB_LOCAL_PASSWORD=
DBHOST=localhost

JWT_SECRET=

# Origin allowed to call this API (defaults to http://localhost:3000 if unset).
# Set to the deployed frontend URL in staging/prod.
CORS_ORIGIN=

# All optional - defaults shown are applied in config/auth.config.js if unset.
# ACCESS_TOKEN_EXPIRES_IN=15m
# REFRESH_TOKEN_TTL_DAYS=30
# PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# Used to build the (currently console-logged, not emailed) password reset link.
# FRONTEND_URL=http://localhost:3000

# Only needed if you want to override the local fallback above (e.g. staging/prod).
# DBDATABASE=
# DBUSERNAME=
# DBPASSWORD=

# Cloudinary (profile image upload) - get these from your Cloudinary dashboard.
CLOUDINARY_NAME=
CLOUDINARY_APIKEY=
CLOUDINARY_SECRET=
