# Copy this file to .env and fill in real values. .env itself is gitignored.

PORT=3001

# Postgres connection string. Free tier: create a project at
# https://neon.tech (or any Postgres host) and paste its connection string
# here. The same DATABASE_URL works for local dev and for Render — there's
# nothing to install locally.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Set to false only when connecting to a Postgres instance that doesn't
# support/require SSL (e.g. a plain local install). Neon/Supabase need this on.
# DB_SSL=false

JWT_SECRET=

# Origin allowed to call this API (defaults to http://localhost:3000 if unset).
# Set to the deployed frontend URL in staging/prod.
CORS_ORIGIN=

# All optional - defaults shown are applied in config/auth.config.js if unset.
# ACCESS_TOKEN_EXPIRES_IN=15m
# REFRESH_TOKEN_TTL_DAYS=30
# PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# Used to build the (currently console-logged, not emailed) password reset link.
# FRONTEND_URL=http://localhost:3000

# Cloudinary (profile image upload) - get these from your Cloudinary dashboard.
CLOUDINARY_NAME=
CLOUDINARY_APIKEY=
CLOUDINARY_SECRET=
